# ==========================================
# WHATSAPP AI CALL SIDECAR (POC OWNER-ONLY)
# Gunakan secret acak yang sama pada proses Node dan Go.
# Session Go tersimpan terpisah di call-service/wa-voip.db.
# ==========================================
CALL_SERVICE_SECRET=ganti_dengan_secret_acak_panjang
CALL_SERVICE_URL=http://127.0.0.1:8787
CALL_SERVICE_ADDR=127.0.0.1:8787
# Pairing code: nomor ini menerima kode linked-device.
CALL_PAIRING_METHOD=code
CALL_PAIRING_PHONE=628xxxxxxxxx
CALL_PAIRING_DISPLAY_NAME=Chrome (Linux)
# Opsional; default berada di samping binary call-service.
CALL_SESSION_DB=call-service/wa-voip.db
CALL_QR_PATH=call-service/pairing-qr.png
CALL_AI_BRIDGE_URL=http://127.0.0.1:8788/turn
CALL_AI_BRIDGE_HOST=127.0.0.1
CALL_AI_BRIDGE_PORT=8788
CALL_STT_PROVIDER=gemini
CALL_STT_MODEL=gemini-2.5-flash
CALL_AI_MODEL=deepseek/deepseek-v4-flash
CALL_MAX_DURATION=5m
CALL_MAX_TURN=15s
CALL_TURN_SILENCE=1200ms
CALL_MIN_SPEECH=700ms
CALL_YTDLP_PATH=yt-dlp
CALL_FFMPEG_PATH=ffmpeg
CALL_MUSIC_MAX_MB=32
CALL_MUSIC_MAX_DURATION=15m
XKIRO_TTS_MODEL=xkiro-voice
XKIRO_TTS_VOICE=mexican-female
# Opsional: daftar voice yang ditampilkan di menu !tts, dipisahkan koma.
XKIRO_TTS_VOICES=mexican-female
XKIRO_TTS_FORMAT=mp3
XKIRO_TTS_SPEED=1

